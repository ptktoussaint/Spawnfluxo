PORT=3000
ADMIN_PASSWORD=troque-esta-senha

# Credenciais da conta de serviço do Firebase (Project Settings > Service accounts >
# Generate new private key, no console do Firebase). Veja o README para o passo a passo.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# true se o app rodar atrás de um proxy/load balancer (ex.: Render, Railway)
TRUST_PROXY=true
