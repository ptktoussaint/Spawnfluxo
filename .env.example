PORT=3000
ADMIN_PASSWORD=troque-esta-senha

# Connection string do Postgres do Supabase (Project Settings > Database >
# Connection string > URI, com a senha do banco já preenchida no lugar de
# [YOUR-PASSWORD]). Veja o README para o passo a passo, incluindo o SQL de
# db/schema.sql que precisa ser rodado uma vez antes de usar.
DATABASE_URL=

# true se o app rodar atrás de um proxy/load balancer (ex.: Render, Railway)
TRUST_PROXY=true

# Endereço público do site, sem barra no final (ex.: https://spawnfluxo.onrender.com).
# Usado no cartão de compartilhamento (og:url e para transformar a imagem em URL
# absoluta). Se ficar vazio, o servidor usa o domínio que veio na requisição —
# funciona, mas esse dado é controlado por quem chama, então em produção vale fixar.
SITE_URL=
